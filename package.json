{
  "name": "openkey-extension",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:passkey": "npx tsx src/passkey/smoke.test.ts",
    "test:interop": "npx tsx scripts/interop_crypto_check.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.7.1",
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/firefox-webext-browser": "^120.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vite-plugin-web-extension": "^4.4.3",
    "vitest": "^3.0.5"
  }
}
